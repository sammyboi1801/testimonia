rules_version = '2';
// Each signed-in reader can read and write only their own data: users/{uid}/blobs/{notes|pins|settings|chats}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/blobs/{blob} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && blob in ['notes', 'pins', 'settings', 'chats']
        && request.resource.data.keys().hasOnly(['json', 'updated'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 1000000;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
