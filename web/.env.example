# Optional: sign-in and sync with Firebase (Auth + Firestore). Copy to web/.env (local) or deploy/oracle/.env (Docker).
# From Firebase console → Project settings → Your apps → Web app. These are not secrets: they ship in the page.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
